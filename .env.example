# Trên Vercel: KHÔNG đặt FAKE_PROVIDERS và EDGE_TTS_DEV; đặt đủ 3 key + APP_USERS + AUTH_SECRET.
# Kiểm trước khi deploy: npm run check-env (cũng tự chạy trước npm run build)

# 1 = dùng giọng + cảnh trám giả lập, không cần key thật (chỉ cho dev)
FAKE_PROVIDERS=1

GOOGLE_TTS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Tuỳ chọn: giọng vclip.io (clone giọng Việt). Lấy key tại https://tts.vclip.io/docs/api-keys
VCLIP_API_KEY=
# JSON, ví dụ: [{"alias":"Hai","voiceId":"...","gender":"MALE"}]
VCLIP_VOICES=

# Tuỳ chọn: giọng clone MiniMax. Clone bằng: npm run minimax:clone -- <file-thu-am> <voiceId> [Alias]
MINIMAX_API_KEY=
# JSON, ví dụ: [{"alias":"Hai","voiceId":"tvsHai001","gender":"MALE"}]
MINIMAX_VOICES=
# Mặc định speech-2.8-hd và https://api.minimax.io
MINIMAX_MODEL=
MINIMAX_BASE_URL=

# Tuỳ chọn: giọng Gemini từ Google AI Studio (không cần thẻ): GEMINI_API_KEY=
GEMINI_API_KEY=
# Mặc định gemini-2.5-flash-preview-tts
GEMINI_MODEL=

# Tuỳ chọn: AI (Gemini, AI Studio) đọc từng câu để gợi ý từ khoá tìm cảnh trám. Thiếu thì dùng từ điển cố định.
# Tách riêng khỏi GEMINI_API_KEY: biến kia bật giọng Gemini, biến này chỉ dùng cho gợi ý từ khoá (có thể cùng một key).
GEMINI_TEXT_API_KEY=
# Mặc định gemini-2.5-flash
GEMINI_TEXT_MODEL=

# Base64 danh sách tài khoản, tạo bằng: npm run user:entry -- <tên> "<Tên hiển thị>" <mật khẩu> [admin|user] rồi npm run user:encode -- users.local.json (admin mới vào được màn Cấu hình)
APP_USERS=

# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 1 = (chỉ khi FAKE_PROVIDERS=1, chỉ trên máy dev) dùng giọng Edge thật qua lệnh edge-tts để nghe thử
EDGE_TTS_DEV=
# Đường dẫn tới edge-tts nếu không có trong PATH
EDGE_TTS_BIN=
