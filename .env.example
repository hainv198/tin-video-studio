# 1 = dùng giọng + cảnh trám giả lập, không cần key thật (chỉ cho dev)
FAKE_PROVIDERS=1

GOOGLE_TTS_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Tuỳ chọn: giọng clone MiniMax. Clone bằng: npm run minimax:clone -- <file-thu-am> <voiceId> [Alias]
MINIMAX_API_KEY=
# JSON, ví dụ: [{"alias":"Hai","voiceId":"tvsHai001","gender":"MALE"}]
MINIMAX_VOICES=
# Mặc định speech-2.8-hd và https://api.minimax.io
MINIMAX_MODEL=
MINIMAX_BASE_URL=

# Base64 danh sách tài khoản, tạo bằng: npm run user:entry ... rồi npm run user:encode -- users.local.json
APP_USERS=

# Chuỗi ngẫu nhiên >= 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 1 = bật trang /dev/dung-thu trên bản production (mặc định tắt)
ENABLE_DEV_PAGES=
