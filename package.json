    "user:entry": "tsx scripts/users.ts entry",
    "user:encode": "tsx scripts/users.ts encode",
    "minimax:clone": "tsx scripts/minimax-clone.ts",
    "measure:mp4": "tsx scripts/measure-mp4.ts",
    "contact:sheet": "tsx scripts/contact-sheet.ts",
    "sample:clip": "tsx scripts/make-sample-clip.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "mediabunny": "1.61.4",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
