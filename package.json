{
  "name": "tin-video-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "check-env": "tsx scripts/check-env.ts",
    "prebuild": "tsx scripts/check-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
